{
  "name": "bus-transport-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter bus-transport-system-web dev",
    "build": "pnpm --filter bus-transport-system-web build",
    "start": "pnpm --filter bus-transport-system-web start",
    "lint": "pnpm --filter bus-transport-system-web lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:generate": "pnpm --filter @bus/db db:generate",
    "db:push": "pnpm --filter @bus/db db:push",
    "db:migrate": "pnpm --filter @bus/db db:migrate",
    "db:studio": "pnpm --filter @bus/db db:studio",
    "db:seed": "tsx packages/db/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.56.0",
    "mapbox-gl": "^3.7.0",
    "next": "15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "eslint-config-next": "15.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.0.0"
}
