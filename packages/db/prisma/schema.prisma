generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  // dbgenerated (not cuid/Prisma-only defaults): the auth.users -> users sync
  // trigger inserts without these columns, so the DEFAULTs must live in the DB
  // and must survive `prisma db push`. See supabase/migrations/
  // 20261010145600_users_id_updated_at_defaults.sql
  id             String          @id @default(dbgenerated("gen_random_uuid()::text"))
  supabaseId     String          @unique @map("supabase_id")
  email          String?         @unique
  phone          String?         @unique
  fullName       String?         @map("full_name")
  avatarUrl      String?         @map("avatar_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @default(dbgenerated("now()")) @map("updated_at")
  role           Role            @default(PASSENGER)
  bookings       Booking[]
  idDeclarations IdDeclaration[]
  bookedSlots    Slot[]          @relation("SlotBookedBy")

  @@map("users")
}

model Bus {
  id           String        @id @default(cuid())
  licensePlate String        @unique @map("license_plate")
  capacity     Int
  currentLat   Float         @map("current_lat")
  currentLng   Float         @map("current_lng")
  heading      Float?
  speed        Float?
  routeId      String        @map("route_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  status       BusStatus     @default(ACTIVE)
  bookings     Booking[]
  positions    BusPosition[]
  route        Route         @relation(fields: [routeId], references: [id])
  slots        Slot[]

  @@index([currentLat, currentLng], map: "idx_buses_lat_lng")
  @@index([status], map: "idx_buses_status")
  @@index([status, currentLat, currentLng], map: "idx_buses_status_lat_lng")
  @@map("buses")
}

model Route {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  color       String      @default("#3B82F6")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  bookings    Booking[]
  buses       Bus[]
  stops       RouteStop[]

  @@map("routes")
}

model Stop {
  id           String      @id @default(cuid())
  name         String
  lat          Float
  lng          Float
  address      String?
  stopCode     String?     @unique @map("stop_code")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  fromBookings Booking[]   @relation("BookingFromStop")
  toBookings   Booking[]   @relation("BookingToStop")
  routeStops   RouteStop[]
  slots        Slot[]

  @@index([lat, lng], map: "idx_stops_lat_lng")
  @@map("stops")
}

model RouteStop {
  id            String   @id @default(cuid())
  routeId       String   @map("route_id")
  stopId        String   @map("stop_id")
  sequence      Int
  estimatedTime Int?     @map("estimated_time")
  createdAt     DateTime @default(now()) @map("created_at")
  route         Route    @relation(fields: [routeId], references: [id])
  stop          Stop     @relation(fields: [stopId], references: [id])

  @@unique([routeId, stopId])
  @@unique([routeId, sequence])
  @@map("route_stops")
}

model Slot {
  id         String     @id @default(cuid())
  busId      String     @map("bus_id")
  stopId     String     @map("stop_id")
  sequence   Int
  bookedById String?    @map("booked_by_id")
  bookedAt   DateTime?  @map("booked_at")
  expiresAt  DateTime?  @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  status     SlotStatus @default(AVAILABLE)
  booking    Booking?
  bookedBy   User?      @relation("SlotBookedBy", fields: [bookedById], references: [id])
  bus        Bus        @relation(fields: [busId], references: [id])
  stop       Stop       @relation(fields: [stopId], references: [id])

  @@index([busId, status])
  @@index([stopId, status])
  @@map("slots")
}

model Booking {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  busId         String         @map("bus_id")
  routeId       String         @map("route_id")
  slotId        String?        @unique @map("slot_id")
  fromStopId    String         @map("from_stop_id")
  toStopId      String         @map("to_stop_id")
  bookedAt      DateTime       @default(now()) @map("booked_at")
  confirmedAt   DateTime?      @map("confirmed_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        BookingStatus  @default(PENDING)
  bus           Bus            @relation(fields: [busId], references: [id])
  fromStop      Stop           @relation("BookingFromStop", fields: [fromStopId], references: [id])
  route         Route          @relation(fields: [routeId], references: [id])
  slot          Slot?          @relation(fields: [slotId], references: [id])
  toStop        Stop           @relation("BookingToStop", fields: [toStopId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  idDeclaration IdDeclaration?

  @@index([userId, status])
  @@index([busId, status])
  @@map("bookings")
}

model BusPosition {
  id         String   @id @default(cuid())
  busId      String   @map("bus_id")
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now()) @map("recorded_at")
  bus        Bus      @relation(fields: [busId], references: [id])

  @@index([busId, recordedAt], map: "idx_bus_positions_bus_time")
  @@map("bus_positions")
}

model IdDeclaration {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  bookingId     String?   @unique @map("booking_id")
  fullName      String    @map("full_name")
  idNumber      String    @map("id_number")
  frontImageUrl String?   @map("front_image_url")
  backImageUrl  String?   @map("back_image_url")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  idType        IdType    @map("id_type")
  status        IdStatus  @default(PENDING)
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("id_declarations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OFFLINE
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IdType {
  CCCD
  VNEID
  PASSPORT
}

enum IdStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}
